            <geometry>
            	<mesh filename="package://moveo_description/meshes/Link_2_edited.STL" />
            </geometry>
        </collision>
        
	<inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>

    </link>
    <joint name="Joint_2" type="revolute">
        <origin xyz="0 0 0.18264" rpy="0 0 0" />
        <parent link="Link_1" />
        <child link="Link_2" />
        <axis xyz="1 0 0" />
        <limit lower="-1.5707963268" upper="1.5707963268" effort="100" velocity="1.919862177191" />
    </joint>

    <link name="Link_3">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
		<mesh filename="package://moveo_description/meshes/Link_3_edited.STL" />
