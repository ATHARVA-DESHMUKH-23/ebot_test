<?xml version="1.0" ?>
<robot name="moveo_description"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="moveo_arm" params="prefix">
  <!-- <link name="world"/> -->

    <!-- <joint name="fixed" type="fixed">
	<parent link="world"/>
	<child link="base_link"/>
	<origin xyz="0 0 0" rpy="0 0 0" />
    </joint> -->

    <parent link="${prefix}base_link"/>

    <link name="${prefix}base_link">
        <visual>
            <origin xyz="0 0.0 0.08" rpy="0 0 0" />
            <geometry>
                <box size="0.20 0.24 0.13"/>
                <!-- <mesh filename="package://moveo_description/meshes/base_link.STL" /> -->
            </geometry>
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 .13" rpy="0 0 0" />
            <geometry>
                <box size="0.20 0.24 0.13"/>
            </geometry>
        </collision>        
	<inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <joint name="Joint_1" type="revolute">
	<origin xyz="0 0 .13" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-1.5707963268" upper="1.5707963268" effort="100" velocity="1.919862177191" />
        <parent link="${prefix}base_link" />
        <child link="Link_1" />
    </joint>

    <link name="Link_1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
		<mesh filename="package://moveo_description/meshes/Link_1_edited.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>        
		<mesh filename="package://moveo_description/meshes/Link_1_edited.STL" />
            </geometry>
        </collision>
	<inertial>
            <mass value="0.1" />
            <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>

    <link name="Link_2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
            	<mesh filename="package://moveo_description/meshes/Link_2_edited.STL" />
