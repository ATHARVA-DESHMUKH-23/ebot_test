<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_hardware" default="false"/>
  <xacro:arg name="use_gripper" default="true"/>

  <xacro:macro name="ebot_ros2_control" params="use_hardware use_gripper">

    <ros2_control name="EbotSystem" type="system">

      <!-- 🔁 Hardware Selection -->
      <hardware>
        <xacro:if value="$(arg use_hardware)">
          <plugin>moveo_hardware/MoveoSystem</plugin>
          <param name="port">/dev/ttyACM0</param>
          <param name="baudrate">115200</param>
        </xacro:if>

        <xacro:unless value="$(arg use_hardware)">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:unless>
      </hardware>

      <!-- 🔧 Arm Joints -->
      <xacro:macro name="arm_joint" params="name">
        <joint name="${name}">
          <command_interface name="position"/>
          <state_interface name="position"/>

          <!-- ❗ Velocity only in simulation
          <xacro:unless value="$(arg use_hardware)">
            <state_interface name="velocity"/>
          </xacro:unless> -->

        </joint>
      </xacro:macro>

      <xacro:arm_joint name="Joint_1"/>
      <xacro:arm_joint name="Joint_2"/>
      <xacro:arm_joint name="Joint_3"/>
      <xacro:arm_joint name="Joint_4"/>
      <xacro:arm_joint name="Joint_5"/>

      <!-- 🤏 Gripper (optional) -->
      <xacro:if value="$(arg use_gripper)">
        <joint name="Gripper_Servo_Gear_Joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>

        <joint name="Gripper_Idol_Gear_Joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>
      </xacro:if>

     <xacro:unless value="${use_hardware}">
      <joint name="FWRJ">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="FWLJ">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:unless>
    </ros2_control>

  </xacro:macro>

</robot>